{
  "name": "realtime-housefest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tunnel": "cloudflared tunnel --url http://localhost:3000",
    "dev:studio": "prisma studio",
    "dev:all": "concurrently -k -n next,tunnel,studio -c blue,magenta,green \"npm:dev\" \"npm:dev:tunnel\" \"npm:dev:studio\"",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vercel/blob": "^2.8.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.15",
    "pusher": "^5.2.0",
    "pusher-js": "^8.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^10.0.5",
    "prisma": "^5.22.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
